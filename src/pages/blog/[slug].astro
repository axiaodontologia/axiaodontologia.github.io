---
/**
 * Artículo del blog. Cada uno genera su HTML con schema Article, lo que
 * permite que Google lo muestre como contenido editorial y no como una
 * página más del sitio.
 */
import Pagina from '../../layouts/Pagina.astro';
import { ARTICULOS } from '../../data/articulos.js';
import { SITIO, wa } from '../../config/sitio.js';

export function getStaticPaths() {
  return ARTICULOS.map((art) => ({ params: { slug: art.slug }, props: { art } }));
}

const { art } = Astro.props;
const ruta = '/blog/' + art.slug;
const relacionados = (art.related || [])
  .map((s) => ARTICULOS.find((a) => a.slug === s))
  .filter(Boolean);

const schema = [
  {
    '@type': 'Article',
    headline: art.h1,
    description: art.desc,
    url: SITIO.url + ruta,
    datePublished: art.iso,
    image: SITIO.url + art.imgSrc,
    author: { '@type': 'Organization', name: art.author },
    publisher: { '@id': SITIO.url + '/#clinica' },
    mainEntityOfPage: SITIO.url + ruta,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITIO.url + '/blog' },
      { '@type': 'ListItem', position: 3, name: art.h1, item: SITIO.url + ruta },
    ],
  },
];

if (art.faqs && art.faqs.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: art.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Pagina titulo={art.title} descripcion={art.desc} ruta={ruta} imagen={art.imgSrc} tipo="article" schema={schema}>
  <article class="ax-seccion ax-editorial">
    <div class="ax-contenedor ax-articulo">
      <nav aria-label="Ruta de navegación" class="ax-migas">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <span>{art.cluster}</span>
      </nav>

      <p class="ax-rotulo">{art.cluster}</p>
      <h1 style="margin-block: var(--ax-e6)">{art.h1}</h1>
      <p class="ax-articulo__entrada">{art.teaser}</p>

      <p class="ax-articulo__firma">
        {art.author} · <time datetime={art.iso}>{art.date}</time> · {art.read}
      </p>

      <img
        src={art.imgSrc}
        alt={art.h1}
        width="1200"
        height="800"
        loading="eager"
        decoding="async"
        class="ax-articulo__portada"
      />

      {art.sections.map((sec) => (
        <section class="ax-articulo__seccion">
          <h2>{sec.h}</h2>
          {sec.paras.map((p) => <p>{p}</p>)}
        </section>
      ))}

      {art.faqs && art.faqs.length > 0 && (
        <section class="ax-articulo__seccion">
          <h2>Preguntas frecuentes</h2>
          {art.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <aside class="ax-articulo__cta">
        <h2>{art.ctaTitle}</h2>
        <p>{art.ctaText}</p>
        <div class="ax-botonera" style="margin-top: var(--ax-e6)">
          <a href={wa(art.waMsg)} class="ax-btn ax-btn--primario" data-track="whatsapp_click" data-origin="articulo">
            Consultar por WhatsApp
          </a>
          <a href="/contacto" class="ax-btn ax-btn--contorno">Agendar mi cita</a>
        </div>
      </aside>

      {relacionados.length > 0 && (
        <section class="ax-articulo__seccion">
          <h2>Sigue leyendo</h2>
          <ul class="ax-relacionados">
            {relacionados.map((r) => (
              <li>
                <a href={`/blog/${r.slug}`}>
                  <img src={r.imgSrc} alt={r.h1} width="1200" height="800" loading="lazy" decoding="async" />
                  <h3>{r.h1}</h3>
                  <p>{r.teaser}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Pagina>

<style>
  .ax-articulo {
    max-width: 760px;
  }

  .ax-migas {
    margin-bottom: var(--ax-e8);
    font-size: var(--ax-txt-sm);
    color: var(--ax-texto-tenue);
  }

  .ax-migas span[aria-hidden] {
    margin: 0 8px;
    color: var(--ax-dorado);
  }

  .ax-articulo__entrada {
    font-size: var(--ax-txt-lg);
    color: var(--ax-texto-suave);
  }

  .ax-articulo__firma {
    margin-top: var(--ax-e6);
    padding-top: var(--ax-e4);
    border-top: 1px solid var(--ax-borde);
    font-size: var(--ax-txt-sm);
    color: var(--ax-texto-tenue);
  }

  .ax-articulo__portada {
    width: 100%;
    height: auto;
    margin-top: var(--ax-e8);
    border-radius: var(--ax-radio-grande);
  }

  .ax-articulo__seccion {
    margin-top: var(--ax-e16);
  }

  .ax-articulo__seccion p {
    margin-top: var(--ax-e4);
    color: var(--ax-texto-suave);
  }

  .ax-articulo__seccion details {
    border-top: 1px solid var(--ax-borde);
    padding-block: var(--ax-e4);
  }

  .ax-articulo__seccion summary {
    cursor: pointer;
    font-weight: var(--ax-peso-medio);
    min-height: 32px;
  }

  .ax-articulo__cta {
    margin-top: var(--ax-e16);
    padding: var(--ax-e12);
    background: var(--ax-clinico-superficie);
    border-radius: var(--ax-radio-grande);
  }

  .ax-articulo__cta p {
    margin-top: var(--ax-e4);
    color: var(--ax-texto-suave);
  }

  .ax-relacionados {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--ax-e8);
    margin-top: var(--ax-e8);
  }

  .ax-relacionados img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .ax-relacionados h3 {
    margin-top: var(--ax-e4);
    font-size: var(--ax-txt-base);
  }

  .ax-relacionados p {
    margin-top: var(--ax-e2);
    font-size: var(--ax-txt-sm);
    color: var(--ax-texto-tenue);
  }
</style>
