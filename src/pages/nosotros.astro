---
import Pagina from '../layouts/Pagina.astro';
import { META } from '../data/meta.js';
import { SITIO, wa } from '../config/sitio.js';

const m = META.nosotros;

// Los cinco profesionales. Lista verificada en INSTRUCCIONES-AXIA.md §2.
// Las biografías, formación y registro profesional siguen sin confirmar:
// no se inventan credenciales ni años de experiencia.
const NOTA_PENDIENTE = 'Formación académica y registro profesional pendientes de confirmar con la clínica.';

const EQUIPO = [
  { nombre: 'Dr. Francisco Díaz Logreira', especialidad: 'Cirugía e implantología oral', img: '/assets/images/team/dr-francisco-diaz-logreira-implantologo-barranquilla.webp' },
  { nombre: 'Dra. Yesmi Molina Rodríguez', especialidad: 'Odontología general y estética dental', img: '/assets/images/team/dra-yesmi-molina-rodriguez-odontologia-general-barranquilla.webp' },
  { nombre: 'Dra. Margarita Maldonado', especialidad: 'Ortodoncia', img: '/assets/images/team/dra-margarita-maldonado-ortodoncista-barranquilla.webp' },
  { nombre: 'Dra. Wendy Collante Mulford', especialidad: 'Estética dental', img: '/assets/images/team/dra-wendy-collante-mulford-estetica-dental-barranquilla.webp' },
  { nombre: 'Dr. Juan Pablo Ospina', especialidad: 'Endodoncia', img: '/assets/images/team/dr-juan-pablo-ospina-endodoncista-barranquilla.webp' },
];

const COMPROMISOS = [
  { t: 'Explicar antes de tratar', d: 'Ves lo que nosotros vemos antes de decidir nada.' },
  { t: 'Tratar solo lo necesario', d: 'Si no hace falta, no se hace. Y te decimos por qué.' },
  { t: 'Bioseguridad sin excepciones', d: 'Instrumental estéril en cada atención, sin atajos.' },
  { t: 'Acompañar después', d: 'El tratamiento no termina el día que sales del sillón.' },
];

const INSTALACIONES = [
  { img: '/assets/images/clinic/axia-espacio-clinica-barranquilla.webp', pie: 'Recepción y sala de espera' },
  { img: '/assets/images/clinic/axia-unidad-odontologica-barranquilla.webp', pie: 'Consultorio y unidad odontológica' },
  { img: '/assets/images/clinic/axia-instrumental-bioseguridad.webp', pie: 'Instrumental estéril en cada atención' },
];

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: SITIO.url + '/nosotros' },
    ],
  },
];
---

<Pagina titulo={m.title} descripcion={m.desc} ruta="/nosotros" schema={schema}>
  <section class="ax-seccion ax-editorial">
    <div class="ax-contenedor">
      <p class="ax-rotulo">La clínica</p>
      <h1 style="margin-block: var(--ax-e6); max-width: 26ch">
        La clínica odontológica que queríamos encontrar como pacientes
      </h1>
      <div class="ax-dos-columnas">
        <div>
          <p>
            Axia Odontología abrió sus puertas en noviembre de 2025 en
            Barranquilla como el proyecto de tres socios que decidieron
            trabajar juntos con una idea simple: explicar antes de tratar, y
            tratar solo lo que hace falta.
          </p>
          <p>
            Somos jóvenes como clínica y rigurosos como equipo. Cada paciente
            entra a una primera consulta de diagnóstico donde revisamos,
            medimos, mostramos y proponemos. Lo que decides, lo decides viendo.
          </p>
        </div>
        <img
          src="/assets/images/clinic/axia-equipo-trabajando-barranquilla.webp"
          alt="El equipo de Axia Odontología durante una atención en Barranquilla"
          width="1500"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="ax-seccion ax-clinico" aria-labelledby="compromisos">
    <div class="ax-contenedor">
      <p class="ax-rotulo">Cómo trabajamos</p>
      <h2 id="compromisos" style="margin-block: var(--ax-e6) var(--ax-e12); max-width: 24ch">
        Cuatro compromisos que no negociamos
      </h2>
      <ul class="ax-compromisos">
        {COMPROMISOS.map((c) => (
          <li>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ax-seccion ax-editorial" aria-labelledby="equipo">
    <div class="ax-contenedor">
      <p class="ax-rotulo">El equipo</p>
      <h2 id="equipo" class="ax-titulo-equipo">Quién va a atenderte</h2>
      <p class="ax-equipo__intro">
        Cinco profesionales atienden en Axia. Pendiente de confirmar con la
        clínica: formación académica, registro profesional y fotografía de
        cada uno.
      </p>
      <ul class="ax-equipo">
        {EQUIPO.map((p) => (
          <li>
            <div class="ax-equipo__foto">
              <img src={p.img} alt={`${p.nombre}, ${p.especialidad} en Axia Odontología Barranquilla`} width="1024" height="1536" loading="lazy" decoding="async" />
            </div>
            <p class="ax-equipo__especialidad">{p.especialidad}</p>
            <h3>{p.nombre}</h3>
            <p class="ax-equipo__nota">{NOTA_PENDIENTE}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ax-seccion ax-clinico" aria-labelledby="instalaciones">
    <div class="ax-contenedor">
      <p class="ax-rotulo">Instalaciones</p>
      <h2 id="instalaciones" style="margin-block: var(--ax-e6) var(--ax-e12)">La clínica por dentro</h2>
      <ul class="ax-instalaciones">
        {INSTALACIONES.map((i) => (
          <li>
            <div class="ax-instalaciones__img">
              <img src={i.img} alt={`${i.pie} de Axia Odontología en Barranquilla`} width="1100" height="1100" loading="lazy" decoding="async" />
            </div>
            <p>{i.pie}</p>
          </li>
        ))}
      </ul>
      <p class="ax-pendiente">
        <strong>Pendiente:</strong> falta una fotografía del área de
        esterilización para completar el recorrido.
      </p>
    </div>
  </section>

  <section class="ax-seccion ax-dorado">
    <div class="ax-contenedor ax-centrado">
      <h2>Conoce la clínica en persona</h2>
      <p class="ax-cta__texto">Agenda una consulta de diagnóstico y te mostramos cómo trabajamos.</p>
      <div class="ax-botonera ax-botonera--centro">
        <a href={wa('Hola, quiero conocer la clínica y agendar una valoración.')} class="ax-btn ax-btn--primario" data-track="whatsapp_click" data-origin="nosotros_cta">
          Agendar por WhatsApp
        </a>
        <a href="/contacto" class="ax-btn ax-btn--contorno">Dejar mis datos</a>
      </div>
    </div>
  </section>
</Pagina>

<style>
  .ax-dos-columnas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ax-e16);
    align-items: center;
    margin-top: var(--ax-e12);
  }
  @media (max-width: 860px) {
    .ax-dos-columnas { grid-template-columns: 1fr; }
  }
  .ax-dos-columnas p { color: var(--ax-texto-suave); }
  .ax-dos-columnas p + p { margin-top: var(--ax-e4); }
  .ax-dos-columnas img { width: 100%; height: auto; border-radius: var(--ax-radio-grande); }

  .ax-compromisos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--ax-e8);
  }
  .ax-compromisos li { border-top: 1px solid var(--ax-borde); padding-top: var(--ax-e4); }
  .ax-compromisos p { margin-top: var(--ax-e2); font-size: var(--ax-txt-sm); color: var(--ax-texto-tenue); }

  .ax-equipo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--ax-e8);
  }
  /* Las fotos son recortes: cuatro con transparencia y una con fondo
     blanco sólido, a escalas distintas. Se unifican sobre una tarjeta
     blanca con  y anclaje abajo, de modo que ninguna cabeza
     queda cortada y la del fondo blanco no se distingue del resto. */
  .ax-titulo-equipo { margin-block: var(--ax-e6) var(--ax-e4); }
  .ax-equipo__intro {
    max-width: 56ch;
    color: var(--ax-texto-tenue);
    margin-bottom: var(--ax-e16);
  }

  .ax-equipo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* Panel cálido detrás de la foto: unifica los recortes, que vienen de
     sesiones distintas y con fondos distintos (cuatro transparentes y uno
     blanco sólido). */
  /* Sin panel: los retratos son recortes con transparencia y se apoyan
     directamente sobre el fondo de la página. */
  .ax-equipo__foto {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: var(--ax-e6);
  }
  .ax-equipo__foto img {
    width: 100%;
    /* height:auto es imprescindible: el atributo height del HTML gana
       sobre aspect-ratio y dejaba la foto de 1536px de alto. */
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .ax-equipo__especialidad {
    font-size: var(--ax-txt-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ax-dorado);
  }
  .ax-equipo h3 { margin-top: var(--ax-e2); font-size: var(--ax-txt-lg); }
  .ax-equipo__nota {
    margin-top: var(--ax-e3);
    font-size: var(--ax-txt-sm);
    color: var(--ax-texto-tenue);
    max-width: 38ch;
  }

  .ax-instalaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--ax-e6);
  }
  .ax-instalaciones__img { aspect-ratio: 1 / 1; overflow: hidden; }
  .ax-instalaciones__img img { width: 100%; height: 100%; object-fit: cover; }
  .ax-instalaciones p { margin-top: var(--ax-e3); font-size: var(--ax-txt-sm); color: var(--ax-texto-tenue); }

  .ax-pendiente {
    margin-top: var(--ax-e8);
    font-size: var(--ax-txt-sm);
    color: var(--ax-texto-tenue);
    max-width: 70ch;
  }

  .ax-centrado { text-align: center; }
  .ax-centrado h2 { max-width: 20ch; margin-inline: auto; }
  .ax-cta__texto { margin: var(--ax-e6) auto 0; max-width: 56ch; color: var(--ax-dorado-texto-tenue); }
  .ax-botonera--centro { justify-content: center; margin-top: var(--ax-e8); }
</style>
